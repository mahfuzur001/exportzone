# ============================================================
# EXPORT ZONE - repository root
# ============================================================

# ------------------------------------------------------------
# Build / deploy artifacts
# ------------------------------------------------------------
# dist/ holds generated shared-hosting ZIPs. Each one embeds a
# plaintext SECRET_KEY and production .env, so it must never be
# committed.
dist/
backups/
deploy-*/
*.zip

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage output
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# ------------------------------------------------------------
# Django runtime state
# ------------------------------------------------------------
# SQLite is the only supported database and holds live orders,
# customers and passwords. Back it up with deploy/backup_data.ps1;
# never commit it.
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm
*.sqlite3
*.sqlite3-journal

# collectstatic output - regenerated by `manage.py collectstatic`
staticfiles/

# User uploads (product/category images)
media/

# Passenger restart marker
tmp/

*.log
test_run.log
pip-log.txt

# ------------------------------------------------------------
# Secrets - never commit these
# ------------------------------------------------------------
# .env.example and .env.production.example are tracked templates;
# the bare .env is not matched by those names.
.env
.env.*
!.env.example
!.env.*.example
.secret_key
*.pem
*.key

# ------------------------------------------------------------
# Scratch / working folders
# ------------------------------------------------------------
# Originals staged by hand before being uploaded into media/.
# The live copy already lives in exportzone/media/.
image/

# ------------------------------------------------------------
# Editors and IDEs
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------
# OS junk
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk
