# Copy this file to .env and replace placeholder values before running Django.
SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EXPORT ZONE <noreply@example.com>
SITE_URL=http://127.0.0.1:8000
SESSION_COOKIE_AGE=1209600

# These are enabled automatically when DEBUG=False. Override only if a trusted
# deployment environment has a specific requirement.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
