# ===========================================================================
# EXPORT ZONE - shared hosting (cPanel / Passenger) production settings
# ===========================================================================
# The build script (deploy/build_shared_hosting_package.ps1) writes this file
# for you from the -Domain you pass it. This template is the reference copy.
#
# Precedence: leave DOTENV_OVERRIDE commented out locally, so this file wins.
# On a shared host set it to 0, so cPanel > Application environment variables
# take precedence and any single value can be changed from the control panel.
# ===========================================================================

# DOTENV_OVERRIDE=0

# --- Core -------------------------------------------------------------------
# Leave empty to let Django reuse the generated .secret_key file instead. A
# real value from cPanel's environment takes priority over both.
SECRET_KEY=

# NEVER true on a public host: it leaks source paths and settings on errors.
DEBUG=False

# Comma separated. Include the bare domain and the www form if both are used.
ALLOWED_HOSTS=exportzone.com,www.exportzone.com

# Scheme + host of every origin the browser may POST a form from. Required for
# HTTPS behind a proxy, and always keep it in step with ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=https://exportzone.com,https://www.exportzone.com

# --- HTTPS / cookies ---------------------------------------------------------
# Without an SSL certificate set SECURE_SSL_REDIRECT=False, otherwise every
# request bounces to https:// and the site appears to be down.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Leave at 0 until the HTTPS certificate is confirmed working, then 31536000.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Turn on only when Cloudflare or the host terminates TLS in front of Django.
TRUST_X_FORWARDED_PROTO=False

# --- Database (SQLite, stored next to the project) ----------------------------
# Raise this if a busy shop ever hits "database is locked".
SQLITE_TIMEOUT=20

# --- Files -------------------------------------------------------------------
# True  = Django serves /static/ and /media/ itself (safe on any shared host).
# False = leave those prefixes to nginx/Apache (faster; needs a web-server rule).
SERVE_STATIC_WITH_DJANGO=True
# Optional absolute path; leave empty to keep logging on stdout.
LOG_FILE=
LOG_LEVEL=INFO

# --- Email -------------------------------------------------------------------
# Use the SMTP details from cPanel > Email Accounts. "console" prints emails
# to the Passenger log instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.exportzone.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EXPORT ZONE <noreply@exportzone.com>
# Absolute https URL with no trailing slash; used in password-reset emails.
SITE_URL=https://exportzone.com
